WAREHOUSE_DB_HOST=127.0.0.1
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse_inventory
WAREHOUSE_DB_USER=postgres
WAREHOUSE_DB_PASSWORD=replace-with-your-postgresql-password
# The interactive setup generates this for you. Supply 32+ random characters for manual setup.
WAREHOUSE_JWT_SECRET=replace-me
WAREHOUSE_TOKEN_MINUTES=60
WAREHOUSE_FAST_UNITS=20
WAREHOUSE_SLOW_UNITS=5
WAREHOUSE_EXPIRY_DAYS=30
