      "auth-service",
      "catalog-service",
      "warehouse-service",
      "reports-service"
    ],
    "database_count": 3,
    "database_per_service_exception": "reports-service is stateless and has no database so the design remains at exactly three databases.",
    "report_service_rationale": "Existing reorder, expiry, valuation, and movement-analysis routes form the added read-only service. Keep PO/GRN and stock together to preserve transaction atomicity.",
    "ids": "INTEGER, matching current models and user-ID range checks.",
    "implementation_status": "implemented_pending_local_database_provisioning"
  },
  "runtime": {
    "stack": [
      "Python",
      "FastAPI",
