AUTH_DATABASE_URL=postgresql+psycopg://identity_app:replace-me@127.0.0.1:5432/warehouse_identity
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=warehouse-api
JWT_AUDIENCE=warehouse-client
TOKEN_MINUTES=60
AUTH_SERVICE_TOKEN=replace-with-one-random-shared-service-token
CATALOG_SERVICE_URL=http://127.0.0.1:8002
UPSTREAM_TIMEOUT_SECONDS=3
